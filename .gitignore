# ==========================================
# 1. BIZTONSÁG ÉS ADATVÉDELEM (Kritikus)
# ==========================================
# Böngésző profilok (sütik, tokenek, session fájlok)
profiles/
**/profiles/

# Hibakeresési képernyőképek (érzékeny képi adatok)
debug_screenshots/
*.png

# SQLite adatbázisok és tranzakciós naplók
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Alkalmazás naplófájlok
*.log
logs/

# ==========================================
# 2. VIRTUÁLIS KÖRNYEZET ÉS IDE BEÁLLÍTÁSOK
# ==========================================
.venv/
venv/
ENV/
env/
.idea/
.vscode/

# ==========================================
# 3. PYTHON ÉS PLAYWRIGHT GYORSÍTÓTÁR
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# Playwright gyorsítótárak
.playwright/
test-results/
playwright-report/

# ==========================================
# 4. FEJLESZTŐI SZEMÉT ÉS ÁTMENETI MENTÉSEK
# ==========================================
*régi*
*.bak
*.tmp

# ==========================================
# 5. OPERÁCIÓS RENDSZER FÁJLOK
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/