# ==========================================
# 1. BIZTONSÁG ÉS ADATVÉDELEM (Kritikus)
# ==========================================
# Böngésző profilok (bejelentkezési sütik, tokenek, session fájlok)
profiles/
**/profiles/
profiles/*

# SQLite adatbázisok és zárolások (helyi vásárlási előzmények)
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Naplófájlok
*.log
logs/

# ==========================================
# 2. VIRTUÁLIS KÖRNYEZET ÉS IDE BEÁLLÍTÁSOK
# ==========================================
.venv/
venv/
ENV/
env/
.idea/
.vscode/

# ==========================================
# 3. PYTHON ÉS PLAYWRIGHT GYORSÍTÓTÁR
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# Playwright teszt- és letöltési gyorsítótár
.playwright/
test-results/
playwright-report/

# ==========================================
# 4. OPERÁCIÓS RENDSZER SZEMÉT
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/